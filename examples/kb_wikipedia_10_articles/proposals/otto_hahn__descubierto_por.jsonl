{"proposal_id": "proposal:7e6279637216", "context": "otto_hahn", "context_id": "ctx:otto_hahn", "wigame_id": "wigame:otto_hahn:descubierto_por", "relation": "descubierto_por", "subject": "radium_226", "object": "pierre_and_marie_curie", "subject_sign": "radium-226", "object_sign": "Pierre and Marie Curie", "truth": "true", "status": "pending", "confidence": 0.85, "sources": ["otto_hahn"], "provenance": [{"source": "otto_hahn", "chunk_id": "otto_hahn/003", "revid": 1375617687, "sentence": "In subsequent years, mesothorium I assumed great importance because, like radium-226 (discovered by Pierre and Marie Curie), it was ideally suited for use in medical radiation treatment, but cost only half as much to manufacture.", "confidence": 0.85}]}
